# Copy to .env.local. Both Clerk keys are the ones already in POC/.env.

# Public — shipped to the browser, safe to expose. This is the one Clerk's
# dashboard labels NEXT_PUBLIC_ for a Next.js app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Server-side only, and required: `clerkMiddleware()` runs on the Next server
# and verifies sessions with it. Without it every route 500s with
# "Missing secretKey" — the publishable key alone is not enough. It is the same
# value the FastAPI app uses, and it must never gain a NEXT_PUBLIC_ prefix.
CLERK_SECRET_KEY=sk_test_...

# Where the FastAPI app is. This origin must be one the backend's CORS_ORIGINS
# allows — it defaults to http://localhost:3000, which is where `npm run dev`
# serves.
NEXT_PUBLIC_API_URL=http://localhost:8000
